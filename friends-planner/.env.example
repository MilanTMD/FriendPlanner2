# Copy this file to .env for local development (.env is git-ignored).
# In production, set these in the Netlify dashboard instead:
# Site configuration > Environment variables (scope: at least "Functions"), then redeploy.

# Shared passcode that opens the site for everyone in the group.
# Production rule: at least 8 characters.
GROUP_PASSCODE=change-me-group

# Admin passcode: edit/delete any plan, reset PINs, delete people.
# Production rule: at least 12 characters and different from GROUP_PASSCODE.
ADMIN_PASSCODE=change-me-admin-passcode

# HMAC key for cookies and IP hashing. At least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
